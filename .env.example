# AlfaComp Store — Environment Variables Example
# Copy this file to .env and fill in your actual credentials.
# SECURITY NOTICE: Never commit .env or secret tokens to a public repository!

# Supabase Database Configuration
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_URL="https://your_project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_anon_key"

# Google Gemini AI Studio API
# Recommended model: gemini-3.5-flash-lite
VITE_GEMINI_API_KEY="your_gemini_api_key_here"
VITE_GEMINI_MODEL="gemini-3.5-flash-lite"

# Telegram Bot Token (used to receive and process orders)
BOT_TOKEN="your_telegram_bot_token_here"
VITE_BOT_TOKEN="your_telegram_bot_token_here"
