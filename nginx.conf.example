# Конфигурация Nginx для AlfaComp.uz и Admin-панели

# 1. Основной магазин (alfacomp.uz)
server {
    listen 80;
    listen [::]:80;
    server_name alfacomp.uz www.alfacomp.uz;

    root /var/www/alfacomp/dist;
    index index.html;

    # Сжатие gzip
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;

    # Мгновенный редирект с /admin на поддомен admin.alfacomp.uz
    location = /admin {
        return 301 https://admin.alfacomp.uz/admin;
    }
    location /admin/ {
        return 301 https://admin.alfacomp.uz/admin;
    }

    # Статические файлы (кеширование на 1 год, если файл не найден — 404, не index.html)
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg|webp|avif)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Сервисные файлы (robots.txt, sitemap.xml)
    location ~* \.(?:txt|xml)$ {
        expires 1d;
        try_files $uri =404;
    }

    # SPA Fallback: все остальные маршруты отдают index.html с кодом 200
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# 2. Поддомен администратора (admin.alfacomp.uz)
server {
    listen 80;
    listen [::]:80;
    server_name admin.alfacomp.uz;

    root /var/www/alfacomp/dist;
    index index.html;

    # Защита на уровне веб-сервера: доступ ТОЛЬКО для разрешённого IP
    allow 144.124.196.58;
    allow 127.0.0.1;
    deny all;

    gzip on;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json image/svg+xml;

    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|eot|ttf|svg|webp|avif)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
